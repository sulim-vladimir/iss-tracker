# The web console as a user service on the Pi - installed by deploy/install-service.sh, which
# fills in @ROOT@ (the checkout). Logs: journalctl --user -u iss-console -f
[Unit]
Description=ISS tracker web console (port 8090)
After=network-online.target
# a console that keeps failing (camera gone, mount in use) stops retrying after 5 starts in 10 min
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@ROOT@
Environment=PYTHONUNBUFFERED=1
# No waiting for network time: the Pi 5 (no RTC battery) boots at its last shutdown time and NTP
# steps the clock ~25 s later, and the console handles that step itself (watch_clock corrects
# what the old time spoiled; the page offers to set the clock when no network time comes).
# Waiting for the sync here kept the console away for that long after every boot.
ExecStart=@ROOT@/.venv/bin/python -m issctl console --web --port 8090
# SIGTERM is the console's graceful stop (state saved, cameras closed); closing the ZWO cameras
# has taken up to 30 s
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
